# Export these in your shell; .env is not loaded automatically.
DJANGO_SETTINGS_MODULE=config.settings.development
PUBLIC_BASE_URL=http://127.0.0.1:5173
# For phone testing only: set your computer's LAN IP here and in PUBLIC_BASE_URL.
# DJANGO_ALLOWED_HOSTS=192.168.1.10

# Default is file delivery into backend/dev-emails/ (no external email sent).
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# To use your SMTP provider, export these and restart Django:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=nowearnow <noreply@nowearnow.com>
